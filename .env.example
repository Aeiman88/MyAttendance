# Copy this file to .env.local (for npm run dev / npm start) or .env (for Docker), then fill it in.

# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the built-in local database (PGlite, stored in ./.data).
# That is perfect for trying the app on your own computer.
#
# For real use, point it at Postgres:
#   Supabase (Vercel deploys): Project → Connect → "Session pooler" string (port 5432), e.g.
#     DATABASE_URL=postgresql://postgres.abcdefghij:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#   (Not the Transaction pooler on port 6543: the database driver used here doesn't work safely with it.)
#   Docker on the Ubuntu server: docker-compose.yml builds this for you from POSTGRES_PASSWORD.
DATABASE_URL=

# ── Sessions ────────────────────────────────────────────────────────────────
# Required whenever DATABASE_URL is set. At least 32 random characters.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Docker only ─────────────────────────────────────────────────────────────
# Password for the Postgres container in docker-compose.yml.
POSTGRES_PASSWORD=

# ── Optional ────────────────────────────────────────────────────────────────
# Show the "Demo data" buttons in Settings on a production build (never on the real system).
# DEMO_MODE=1

# Extra hostnames allowed to send requests, if a reverse proxy rewrites the Host header.
# APP_ORIGINS=myattendance.example.com

# ── Street maps ─────────────────────────────────────────────────────────────
# The maps on the website and in the phone app use CARTO's free map tiles, which need a key
# since September 2026. Get one free at https://carto.com/basemaps/apikey (it arrives by e-mail).
# Without a key the maps still work (zone, your position), just without streets.
# The phone app gets the map settings from the server, so changing the key never needs a new app build.
# NEXT_PUBLIC_CARTO_API_KEY=your-carto-key
#
# Or use a different tile service instead:
# NEXT_PUBLIC_MAP_TILES=https://tiles.example.com/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
