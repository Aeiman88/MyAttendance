{
  "name": "myattendance-app",
  "version": "1.0.0",
  "private": true,
  "description": "MyAttendance staff app (Android / iPhone) for DAICOE: GPS clock in/out, history, requests and the printable attendance form.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build --platform android --profile preview",
    "build:playstore": "eas build --platform android --profile production",
    "sync-shared": "node scripts/sync-shared.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3"
  }
}
